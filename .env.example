# ==========================================
# SQL Office Simulator - Environment Config
# ==========================================

# 1. Application Database (App DB - User profiles, progress, attempts, configuration)
# For Supabase / Cloud Postgres:
APP_DATABASE_URL="postgresql://postgres.ewxqlgfkulexrzmqpksb:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.ewxqlgfkulexrzmqpksb:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# 2. Practice Sandbox Database (Sandbox DB - 35 domain-level schemas + validation variants)
# Uses isolated PostgreSQL instance running on port 5433 with restricted sandbox_readonly role
SANDBOX_DATABASE_ADMIN_URL="postgresql://postgres:sandboxtopsecret@localhost:5433/sql_office_sandbox"
SANDBOX_DATABASE_URL="postgresql://sandbox_readonly:sandbox_readonly_pass@localhost:5433/sql_office_sandbox"

# 3. NextAuth / Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sql-office-simulator-super-secret-development-key-change-in-production-12345"

# 4. Google OAuth (Optional in early dev, enabled when configured in Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. Honor Policy Configuration
AI_HONOR_PLEDGE_ENABLED="true"

# 6. Administrator Portal Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-secure-admin-password-in-production"

# 7. Outgoing Email / SMTP (Optional: For sending real password reset emails)
# If left blank, password reset links are printed strictly to server logs in dev mode
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SQL Office Simulator <noreply@sqloffice.com>"
